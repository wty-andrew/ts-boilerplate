{
  "name": "ts-boilerplate",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./dist/index.js",
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false ./src/index.ts",
    "build": "cross-env NODE_ENV=production tsc --build tsconfig.prod.json",
    "test": "cross-env NODE_ENV=test vitest",
    "lint": "biome check src",
    "prebuild": "rimraf dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "cross-env": "^7.0.3",
    "pino-pretty": "^11.2.0",
    "rimraf": "^5.0.7",
    "supertest": "^7.0.0",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "uuid": "^10.0.0"
  }
}
